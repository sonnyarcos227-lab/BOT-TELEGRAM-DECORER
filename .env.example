# Token que te da @BotFather en Telegram al crear el bot
BOT_TOKEN=

# Tu chat_id de Telegram (el único autorizado para subir el Excel de inventario)
# Puede haber varios separados por coma: 123456789,987654321
ADMIN_CHAT_IDS=

# Carpeta donde se guarda la base de datos (en Railway usa el volumen montado, ej: /data)
DATA_DIR=./data
